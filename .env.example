# Age Prediction Service — environment variables
# Copy to .env and adjust paths before running.

# Path to model checkpoint. Default: notebooks/models/distilled_resnet18.pth
MODEL_PATH=notebooks/models/distilled_resnet18.pth

# Backbone architecture (must match the checkpoint)
BACKBONE_NAME=resnet18

# Input image size (must match training)
IMAGE_SIZE=224

# LRU cache capacity (number of unique images)
CACHE_SIZE=10000

# Max uploaded file size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# Max images per /v1/predict_batch request
MAX_BATCH_SIZE=8

# Max simultaneous forward passes
MAX_CONCURRENCY=4

# Set to true for detailed FastAPI tracebacks
DEBUG=false
